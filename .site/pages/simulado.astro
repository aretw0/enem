---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import sources from '../../data/sources.json';

const questionFiles = import.meta.glob('../../data/questions/*.json', {
  eager: true,
  import: 'default',
}) as Record<string, any[]>;
const sourceById = new Map(sources.map((source) => [source.id, source]));
const bank = Object.values(questionFiles)
  .flat()
  .filter((question) => question.provenance?.reviewStatus === 'verified')
  .map((question) => ({
    id: question.id,
    item: question.item,
    year: question.year,
    area: question.area,
    prompt: question.prompt,
    alternatives: question.alternatives,
    answer: question.answer,
    sourceId: question.sourceId,
    sourceUrl: sourceById.get(question.sourceId)?.url,
    sourceFile: question.provenance.sourceFile,
    sourcePage: question.provenance.page,
  }));
const areaCounts = bank.reduce<Record<string, number>>((counts, question) => {
  counts[question.area] = (counts[question.area] ?? 0) + 1;
  return counts;
}, {});
const areaSummary = [
  ['natureza', 'Natureza'],
  ['matematica', 'Matemática'],
]
  .filter(([area]) => areaCounts[area])
  .map(([area, label]) => `${areaCounts[area]} de ${label}`)
  .join(' · ');
const serializedBank = JSON.stringify(bank).replaceAll('<', '\\u003c');
---

<StarlightPage frontmatter={{ title: 'Simulado ENEM', description: 'Bloco reproduzível de questões oficiais verificadas, com confiança e análise após a entrega.' }}>
  <main class="enem-simulator" data-enem-simulator>
    <header>
      <p class="vault-section-label">Prática de recuperação</p>
      <p class="enem-simulator__title">Bloco de questões verificadas</p>
      <p class="vault-lead">
        Responda sem consultar material e receba feedback somente ao entregar. Registre também sua
        confiança: um acerto de baixa confiança continua sendo candidato a revisão.
      </p>
      <div class="enem-simulator__status" role="status">
        <strong>{bank.length} questões disponíveis</strong>
        <span>{areaSummary} · 2025 · aplicação regular · Caderno 7 Azul</span>
      </div>
    </header>

    <aside class="enem-simulator__notice">
      Este acervo cobre parte de Ciências da Natureza e Matemática; ainda não representa um simulado
      completo nem a distribuição oficial do ENEM. No modo misto, o bloco apenas alterna igualmente
      as áreas disponíveis. O resultado é acerto bruto; não é nota TRI.
    </aside>

    <form class="enem-simulator__setup" data-simulator-setup>
      <label>
        Recorte do bloco
        <select name="area">
          <option value="mixed" selected>Misto equilibrado</option>
          <option value="natureza">Ciências da Natureza</option>
          <option value="matematica">Matemática</option>
          <option value="review">Minha fila de retomada</option>
        </select>
      </label>
      <label>
        Tamanho do bloco
        <select name="size">
          <option value="5">5 questões</option>
          <option value="10" selected>10 questões</option>
        </select>
      </label>
      <label>
        Identificador reproduzível
        <input name="seed" value="enem-2025-misto-1" autocomplete="off" />
      </label>
      <button class="vault-button" type="submit">Montar bloco</button>
      <p class="enem-simulator__queue-status" data-review-queue-status aria-live="polite"></p>
    </form>

    <section class="enem-simulator__session" data-simulator-session hidden aria-labelledby="session-title">
      <div class="enem-simulator__session-header">
        <div>
          <p class="vault-section-label">Sessão em andamento</p>
          <h2 id="session-title" data-session-title>Bloco</h2>
        </div>
        <p data-progress aria-live="polite"></p>
      </div>
      <form data-question-form>
        <div data-question-list></div>
        <button class="vault-button" type="submit">Entregar e corrigir</button>
      </form>
    </section>

    <section class="enem-simulator__result" data-simulator-result hidden aria-labelledby="result-title" aria-live="polite">
      <p class="vault-section-label">Feedback do bloco</p>
      <h2 id="result-title">Resultado bruto</h2>
      <div class="enem-simulator__metrics" data-result-metrics></div>
      <div data-result-review></div>
      <div class="vault-actions">
        <button class="vault-button vault-button--secondary" type="button" data-download-session>Baixar registro .md</button>
        <button class="vault-button" type="button" data-new-block>Novo embaralhamento</button>
        <a class="vault-button vault-button--secondary" href="../recursos/enem/pratica/ciclo-de-questoes-e-analise-de-erros/">Analisar os erros</a>
      </div>
    </section>

    <noscript>Ative JavaScript para montar e corrigir o bloco localmente no navegador.</noscript>
    <script id="enem-question-bank" type="application/json" set:html={serializedBank}></script>
  </main>
</StarlightPage>

<script>
  import {
    attemptToMarkdown,
    evaluateAttempt,
    selectBalancedQuestions,
    selectQuestions,
    updateReviewQueue,
  } from '@aretw0/enem-domain/simulator';

  const root = document.querySelector('[data-enem-simulator]');
  const bankNode = document.querySelector('#enem-question-bank');
  if (root instanceof HTMLElement && bankNode) {
    const bank = JSON.parse(bankNode.textContent || '[]');
    const setup = root.querySelector('[data-simulator-setup]');
    const session = root.querySelector('[data-simulator-session]');
    const questionForm = root.querySelector('[data-question-form]');
    const questionList = root.querySelector('[data-question-list]');
    const resultSection = root.querySelector('[data-simulator-result]');
    let selected = [];
    let startedAt = 0;
    let completed = null;

    const letter = (index) => String.fromCharCode(65 + index);
    const areaLabels = {
      mixed: 'Misto equilibrado',
      natureza: 'Ciências da Natureza',
      matematica: 'Matemática',
      review: 'Fila de retomada',
    };
    const reviewQueueKey = 'enem-vault:review-queue:v1';
    const storageKey = (seed, size, area) => `enem-vault:simulado:${area}:${seed}:${size}`;
    const safeStored = (key, fallback = {}) => {
      try { return JSON.parse(localStorage.getItem(key) || JSON.stringify(fallback)); } catch { return fallback; }
    };

    function reviewQueue() {
      const queue = safeStored(reviewQueueKey, []);
      return Array.isArray(queue) ? queue : [];
    }

    function refreshQueueStatus(message) {
      const count = reviewQueue().length;
      root.querySelector('[data-review-queue-status]').textContent = message ?? (
        count
          ? `${count} ${count === 1 ? 'questão aguarda' : 'questões aguardam'} retomada. A fila fica somente neste navegador.`
          : 'A fila de retomada está vazia. Erros, omissões e acertos de baixa confiança entram nela automaticamente.'
      );
    }

    function renderQuestion(question, index, stored) {
      const fieldset = document.createElement('fieldset');
      fieldset.className = 'enem-question';
      fieldset.dataset.questionId = question.id;
      const legend = document.createElement('legend');
      legend.textContent = `${index + 1}. ${areaLabels[question.area]} · Questão ${question.item}`;
      fieldset.append(legend);
      for (const paragraphText of question.prompt.split(/\n\n+/)) {
        const paragraph = document.createElement('p');
        paragraph.textContent = paragraphText;
        fieldset.append(paragraph);
      }
      const alternatives = document.createElement('div');
      alternatives.className = 'enem-question__alternatives';
      question.alternatives.forEach((text, alternativeIndex) => {
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = `answer-${question.id}`;
        input.value = letter(alternativeIndex);
        input.checked = stored?.answer === input.value;
        const marker = document.createElement('strong');
        marker.textContent = input.value;
        const content = document.createElement('span');
        content.textContent = text;
        label.append(input, marker, content);
        alternatives.append(label);
      });
      fieldset.append(alternatives);
      const confidence = document.createElement('label');
      confidence.className = 'enem-question__confidence';
      confidence.append('Confiança ');
      const select = document.createElement('select');
      select.name = `confidence-${question.id}`;
      for (const [value, text] of [['', 'não informada'], ['low', 'baixa'], ['medium', 'média'], ['high', 'alta']]) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = text;
        option.selected = stored?.confidence === value;
        select.append(option);
      }
      confidence.append(select);
      fieldset.append(confidence);
      return fieldset;
    }

    function responses() {
      return Object.fromEntries(selected.map((question) => ({
        question,
        answer: questionForm.elements.namedItem(`answer-${question.id}`)?.value || null,
        confidence: questionForm.elements.namedItem(`confidence-${question.id}`)?.value || null,
      })).map(({ question, answer, confidence }) => [question.id, { answer, confidence }]));
    }

    function updateProgress() {
      const answered = Object.values(responses()).filter((response) => response.answer).length;
      root.querySelector('[data-progress]').textContent = `${answered}/${selected.length} respondidas`;
      const size = Number(setup.elements.namedItem('size').value);
      const seed = setup.elements.namedItem('seed').value.trim();
      const area = setup.elements.namedItem('area').value;
      localStorage.setItem(storageKey(seed, size, area), JSON.stringify(responses()));
    }

    function mountBlock() {
      const size = Number(setup.elements.namedItem('size').value);
      const area = setup.elements.namedItem('area').value;
      const seed = setup.elements.namedItem('seed').value.trim() || 'enem-2025-misto-1';
      setup.elements.namedItem('seed').value = seed;
      const queuedIds = new Set(reviewQueue().map((entry) => entry.id));
      const scopedBank = area === 'mixed'
        ? bank
        : area === 'review'
          ? bank.filter((question) => queuedIds.has(question.id))
          : bank.filter((question) => question.area === area);
      selected = area === 'mixed'
        ? selectBalancedQuestions(scopedBank, { seed, size })
        : selectQuestions(scopedBank, { seed, size });
      if (!selected.length) {
        session.hidden = true;
        resultSection.hidden = true;
        refreshQueueStatus('A fila está vazia. Conclua um bloco para registrar pontos de retomada.');
        return;
      }
      const stored = safeStored(storageKey(seed, size, area));
      questionList.replaceChildren(...selected.map((question, index) => renderQuestion(question, index, stored[question.id])));
      root.querySelector('[data-session-title]').textContent = `${areaLabels[area]} · ${selected.length} questões · seed ${seed}`;
      session.hidden = false;
      resultSection.hidden = true;
      startedAt = performance.now();
      updateProgress();
      history.replaceState(null, '', `${location.pathname}?area=${area}&seed=${encodeURIComponent(seed)}&size=${selected.length}`);
      session.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    setup.addEventListener('submit', (event) => { event.preventDefault(); mountBlock(); });
    questionForm.addEventListener('change', updateProgress);
    questionForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const attempt = evaluateAttempt(selected, responses());
      const elapsedMinutes = Math.max(1, Math.round((performance.now() - startedAt) / 60000));
      completed = { attempt, elapsedMinutes };
      const updatedQueue = updateReviewQueue(reviewQueue(), attempt, selected, { at: new Date().toISOString() });
      localStorage.setItem(reviewQueueKey, JSON.stringify(updatedQueue));
      refreshQueueStatus();
      const metrics = root.querySelector('[data-result-metrics]');
      metrics.replaceChildren();
      for (const [value, label] of [
        [`${attempt.correct}/${attempt.total}`, 'acertos'],
        [String(attempt.incorrect), 'erros'],
        [String(attempt.unanswered), 'em branco'],
        [String(attempt.fragile), 'acertos frágeis'],
        [`${elapsedMinutes} min`, 'tempo nesta tela'],
      ]) {
        const card = document.createElement('div');
        const strong = document.createElement('strong');
        strong.textContent = value;
        const span = document.createElement('span');
        span.textContent = label;
        card.append(strong, span);
        metrics.append(card);
      }
      const review = root.querySelector('[data-result-review]');
      review.replaceChildren();
      for (const item of attempt.items.filter((entry) => !entry.correct || entry.fragile)) {
        const row = document.createElement('article');
        row.className = `enem-review ${item.correct ? 'enem-review--fragile' : 'enem-review--error'}`;
        const title = document.createElement('h3');
        title.textContent = `Questão ${item.item}: ${item.correct ? 'acerto de baixa confiança' : item.unanswered ? 'em branco' : 'resposta incorreta'}`;
        const detail = document.createElement('p');
        detail.textContent = `Sua resposta: ${item.selected ?? '—'} · Gabarito oficial: ${item.answer} · Confiança: ${item.confidence ?? 'não informada'}`;
        const sourceQuestion = selected.find((question) => question.id === item.id);
        const source = document.createElement('a');
        source.href = sourceQuestion.sourceUrl;
        source.target = '_blank';
        source.rel = 'noreferrer';
        source.textContent = `Abrir prova oficial · página ${sourceQuestion.sourcePage}`;
        row.append(title, detail, source);
        review.append(row);
      }
      if (!review.children.length) {
        const message = document.createElement('p');
        message.textContent = 'Nenhum erro ou acerto de baixa confiança neste bloco.';
        review.append(message);
      }
      questionForm.querySelectorAll('input, select, button').forEach((control) => { control.disabled = true; });
      resultSection.hidden = false;
      resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    root.querySelector('[data-new-block]').addEventListener('click', () => {
      setup.elements.namedItem('seed').value = `enem-${Date.now().toString(36)}`;
      questionForm.querySelectorAll('input, select, button').forEach((control) => { control.disabled = false; });
      mountBlock();
    });

    root.querySelector('[data-download-session]').addEventListener('click', () => {
      if (!completed) return;
      const seed = setup.elements.namedItem('seed').value.trim();
      const date = new Date().toISOString().slice(0, 10);
      const markdown = attemptToMarkdown({
        attempt: completed.attempt,
        questions: selected,
        seed,
        date,
        elapsedMinutes: completed.elapsedMinutes,
      });
      const url = URL.createObjectURL(new Blob([markdown], { type: 'text/markdown;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url;
      link.download = `sessao-enem-${date}-${seed.replace(/[^a-z0-9-]+/gi, '-').toLowerCase()}.md`;
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 0);
    });

    const params = new URLSearchParams(location.search);
    if (['mixed', 'natureza', 'matematica', 'review'].includes(params.get('area'))) {
      setup.elements.namedItem('area').value = params.get('area');
    }
    if (params.get('seed')) setup.elements.namedItem('seed').value = params.get('seed');
    if (['5', '10'].includes(params.get('size'))) setup.elements.namedItem('size').value = params.get('size');
    refreshQueueStatus();
  }
</script>
